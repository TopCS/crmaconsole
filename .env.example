export POSTHOG_KEY=phc_***
export NPM_TOKEN=npm_***
export OPENROUTER_API_KEY=
export COMPOSIO_API_KEY=
export CRM_A_DEFAULT_MODEL=openrouter/deepseek/deepseek-v4-pro

# Phone outbound (NLPearl) — webhook route auth + NLPearl credentials
export CRM_A_PHONE_WEBHOOK_SECRET=
# Il gateway OpenClaw deve vedere lo stesso segreto della web app (forward in docker-compose o env shell)
export NLPEARL_ACCOUNT_ID=
export NLPEARL_SECRET_KEY=
export NLPEARL_BASE_URL=
export NLPEARL_VOICE_ID=

# Reachability for NLPearl callbacks (demo): Tailscale funnel — the container
# joins the tailnet, publishes :3100 and exports CRM_A_CONSOLE_PUBLIC_URL.
# Requires a reusable auth key and funnel enabled for the node in the ACLs.
# (In this setup the funnel runs on the host: top-mgm-00.taileb6b.ts.net)
export TAILSCALE_AUTHKEY=
export TAILSCALE_HOSTNAME=crm-a-console
# Public origin actually used for callbacks/webhooks (set explicitly when the
# funnel is not the container's own; overrides the auto-detected URL).
export CRM_A_CONSOLE_PUBLIC_URL=https://top-mgm-00.taileb6b.ts.net

# E-commerce touchpoint (Shopify dev store): API secret verifies the webhook
# HMAC (X-Shopify-Hmac-Sha256). When unset, the webhook accepts ?token= with
# the console phone-webhook secret instead (dev fallback).
export SHOPIFY_CLIENT_ID=e2f6ffbbb077827c83e124f380464b78  # app dedicata CRM-A Touchpoint
export SHOPIFY_API_SECRET=
export SHOPIFY_STORE_DOMAIN=electronyca.myshopify.com
# Admin API access token (shpat_...) for the agent helpers in skills/shopify/scripts/
# (products/orders/fulfill prep). Different from SHOPIFY_API_SECRET.
export SHOPIFY_ADMIN_TOKEN=
export SHOPIFY_API_VERSION=2026-07

# ── Security gate (operator session) ───────────────────────────────────────
# Every CRM/workspace/memory route requires a signed operator session.
# Sessions are issued only after a successful Keycloak login; the cookie is
# signed with CRM_A_SESSION_SECRET (>=16 chars). Identity is NOT stored here.
# Set your own values; never commit real credentials.
export CRM_A_SESSION_SECRET=
# Service-to-service token for internal tools (agent <-> console API).
# Separate from webhook secrets: rotate independently.
export CRM_A_SERVICE_TOKEN=

# ── Keycloak (OIDC identity provider) ──────────────────────────────────────
# Browser-facing issuer (must match the `iss` claim exactly).
export CRM_A_OIDC_ISSUER=http://localhost:8080/realms/crm-a
# Server-side issuer for token/JWKS calls. Same as above when running Next.js
# directly on the host. Docker Compose overrides it with the service DNS
# (CRM_A_OIDC_INTERNAL_ISSUER_DOCKER) so the container can reach keycloak:8080.
export CRM_A_OIDC_INTERNAL_ISSUER=http://localhost:8080/realms/crm-a
# export CRM_A_OIDC_INTERNAL_ISSUER_DOCKER=http://keycloak:8080/realms/crm-a
export CRM_A_OIDC_CLIENT_ID=crm-a-console
export CRM_A_OIDC_CLIENT_SECRET=crm-a-demo-client-secret
export CRM_A_OIDC_REDIRECT_URI=http://localhost:3100/api/auth/callback
export CRM_A_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3100/login
# Admin REST client used by /maxxi/operators (server-side only).
export CRM_A_KEYCLOAK_ADMIN_CLIENT_ID=crm-a-admin
export CRM_A_KEYCLOAK_ADMIN_CLIENT_SECRET=crm-a-admin-demo-secret

# Keycloak / PostgreSQL bootstrap (docker-compose).
export KEYCLOAK_ADMIN_USER=admin
export KEYCLOAK_ADMIN_PASSWORD=admin-demo-password
export KEYCLOAK_DB_PASSWORD=keycloak-demo-db-password

# Public URLs used by OIDC and redirects. For zrok, set these to the two
# public share URLs and mirror them in CRM_A_OIDC_* below.
export CRM_A_PUBLIC_URL=http://localhost:3100
export CRM_A_KEYCLOAK_PUBLIC_URL=http://localhost:8080
export CRM_A_KEYCLOAK_ADMIN_URL=http://localhost:8080

# ── zrok publication (optional profile) ──────────────────────────────────
# Enable a zrok account/token first; see docs/maxxi/ZROK.md.
export ZROK_ENABLE_TOKEN=
export ZROK_API_ENDPOINT=https://api.zrok.io
export ZROK_ENVIRONMENT_NAME=crm-a
export ZROK_UNIQUE_NAME=crm-a-console
export ZROK_KEYCLOAK_UNIQUE_NAME=crm-a-keycloak
# Optional target overrides (defaults point at the Compose services).
# export ZROK_TARGET=http://crm-a-console:3100
# export ZROK_KEYCLOAK_TARGET=http://keycloak:8080

# ── MAXXI CDP demo ─────────────────────────────────────────────────────────
# 1 = all outbound providers (email, telegram, phone, NLPearl writes) are blocked.
export CRM_A_DEMO_MODE=1
# Chat AI model (OpenRouter id). Default: openai/gpt-4o-mini.
# Leave unset to use the default; the verified mode works without any key.
# export MAXXI_CHAT_MODEL=openrouter/openai/gpt-4o-mini
# Optional overrides for the isolated demo database and fixture path.
# export CRM_A_MAXXI_DB_DIR=/root/.openclaw-crm-a/maxxi-demo
# export CRM_A_MAXXI_FIXTURE=/app/docs/fixtures/maxxi_demo_seed.json
