export POSTHOG_KEY=phc_***
export NPM_TOKEN=npm_***
export OPENROUTER_API_KEY=
export COMPOSIO_API_KEY=
export CRM_A_DEFAULT_MODEL=openrouter/deepseek/deepseek-v4-pro

# Phone outbound (NLPearl) — webhook route auth + NLPearl credentials
export CRM_A_PHONE_WEBHOOK_SECRET=
# Il gateway OpenClaw deve vedere lo stesso segreto della web app (forward in docker-compose o env shell)
export NLPEARL_ACCOUNT_ID=
export NLPEARL_SECRET_KEY=
export NLPEARL_BASE_URL=
export NLPEARL_VOICE_ID=

# Reachability for NLPearl callbacks (demo): Tailscale funnel — the container
# joins the tailnet, publishes :3100 and exports CRM_A_CONSOLE_PUBLIC_URL.
# Requires a reusable auth key and funnel enabled for the node in the ACLs.
export TAILSCALE_AUTHKEY=
export TAILSCALE_HOSTNAME=crm-a-console

# E-commerce touchpoint (Shopify dev store): API secret verifies the webhook
# HMAC (X-Shopify-Hmac-Sha256). When unset, the webhook accepts ?token= with
# the console phone-webhook secret instead (dev fallback).
export SHOPIFY_API_SECRET=
export SHOPIFY_STORE_DOMAIN=
# Admin API access token (shpat_...) for the agent helpers in skills/shopify/scripts/
# (products/orders/fulfill prep). Different from SHOPIFY_API_SECRET.
export SHOPIFY_ADMIN_TOKEN=
export SHOPIFY_API_VERSION=2024-10
